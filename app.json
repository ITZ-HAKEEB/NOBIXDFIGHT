{
  "name": "Nobi XD Fight Bot",
  "description": "Telegram Voice Chat Fight Bot with Dynamic Hosting Panel",
  "repository": "https://github.com/ITZ-HAKEEB/NOBIXDFIGHT",
  "logo": "https://graph.org/file/sample-logo.jpg",
  "keywords": ["python", "pyrogram", "telegram", "voice-chat", "fight-bot"],
  "stack": "container",
  "env": {
    "API_ID": {
      "description": "Get your API_ID from my.telegram.org",
      "value": "",
      "required": true
    },
    "API_HASH": {
      "description": "Get your API_HASH from my.telegram.org",
      "value": "",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Your Telegram Bot Token from @BotFather",
      "value": "",
      "required": true
    },
    "OWNER_ID": {
      "description": "Your Telegram Owner User ID",
      "value": "",
      "required": true
    },
    "OWNER_USERNAME": {
      "description": "Your Telegram Owner Username (without @)",
      "value": "your_username",
      "required": false
    },
    "SUPPORT_CHAT": {
      "description": "Your Support Group or Channel Link",
      "value": "https://t.me/your_support_chat",
      "required": false
    },
    "UPDATE_CHANNEL": {
      "description": "Your Updates Channel Link",
      "value": "https://t.me/your_updates_channel",
      "required": false
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "eco"
    }
  }
}
